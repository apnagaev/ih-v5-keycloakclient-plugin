{
  "name": "ldapclient",
  "description": "LDAP client plugin (Keycloak)",
  "service": "ldap",
  "single": 1,
  "nochannels": 1,
  "passwordProp": "clientSecret",
  "restartOnChannelsChange": 0,
  "server":"5.19.32",
  "plugin_popup": [
    {
      "id": "syncGroups",
      "type": "item",
      "title": "Импорт групп KEYCLOAK",
      "command": "send",
      "param": {
        "emit": "plugin_command:syncGroups"
      }
    },
    {
      "id": "syncUsers",
      "type": "item",
      "title": "Импорт пользователей KEYCLOAK",
      "command": "send",
      "param": {
        "emit": "plugin_command:syncUsers"
      }
    }
  ]
}
